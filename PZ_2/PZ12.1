# В матрице элементы кратные 3 увеличить в 3 раза.
import random

rows = int(input("Введите количество строк: "))
cols = int(input("Введите количество столбцов: "))

matrix = [[random.randint(-20, 20) for _ in range(cols)] for _ in range(rows)]

print("\nИсходная матрица:")
for row in matrix:
    print(row)

for i in range(rows):
    for j in range(cols):
        if matrix[i][j] % 3 == 0:
            matrix[i][j] *= 3

print("\nМатрица после обработки:")
for row in matrix:
    print(row)
